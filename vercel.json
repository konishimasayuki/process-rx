{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/fax-intake.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@napi-rs/**"
    },
    "api/fax-preview.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@napi-rs/**"
    },
    "api/fax-layout.js": {
      "maxDuration": 30
    },
    "api/fax-edit.js": {
      "maxDuration": 30
    },
    "api/fax-selftest.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@napi-rs/**"
    },
    "api/fax-regroup.js": {
      "maxDuration": 60
    },
    "api/fax-extract.js": {
      "maxDuration": 60
    }
  }
}
